# filepath: docker/Dockerfile.backend
# ==============================================================================
# Production Dockerfile for FastAPI Recommendation Serving Gateway
# ==============================================================================

FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app"

# Install system dependencies & curl for container health check
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        curl \
        libpq-dev \
        gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python requirements with layer caching
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir dbt-core dbt-postgres

# Copy application and dbt modules
COPY backend/ backend/
COPY dbt_project/ dbt_project/
COPY mlops/ mlops/

# Configure entrypoint
COPY docker/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

# Expose FastAPI port
EXPOSE 8000

# Container Healthcheck verifying Sub-5ms SLA
HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]